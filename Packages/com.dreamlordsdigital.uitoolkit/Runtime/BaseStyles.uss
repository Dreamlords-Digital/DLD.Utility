:root {
    --dld-color-border-warning: rgb(195, 133, 0);
    --dld-color-label-warning: rgb(195, 133, 0);
    --dld-color-label-warning-focused: rgb(255, 193, 61);
    --dld-color-border-error: rgb(181, 0, 0);
    --dld-color-label-error: rgb(212, 78, 78);
    --dld-color-label-error-focused: rgb(255, 105, 105);
}

.unity-label {
    color: rgb(238, 238, 238);
}

.dld-text-field {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
}

.dld-text-field > #unity-text-input {
    padding-top: 1px;
    padding-right: 2px;
    padding-bottom: 1px;
    padding-left: 2px;
    background-color: rgb(42, 42, 42);
    border-left-color: rgb(33, 33, 33);
    border-right-color: rgb(33, 33, 33);
    border-top-color: rgb(13, 13, 13);
    border-bottom-color: rgb(33, 33, 33);
}

.dld-text-field:hover > #unity-text-input {
    cursor: text;
    border-left-color: rgb(101, 101, 101);
    border-right-color: rgb(101, 101, 101);
    border-top-color: rgb(101, 101, 101);
    border-bottom-color: rgb(101, 101, 101);
}

.dld-text-field:hover > #unity-text-input > TextElement {
    cursor: text;
}

.dld-text-field > #unity-text-input > TextElement {
    color: rgb(185, 185, 185);
    padding-top: 0;
}

.dld-text-field:focus > #unity-text-input {
    border-left-color: rgb(44, 93, 135);
    border-right-color: rgb(44, 93, 135);
    border-top-color: rgb(44, 93, 135);
    border-bottom-color: rgb(44, 93, 135);
}

.dld-text-field:focus > Label {
    color: rgb(121, 166, 233);
}

.dld-text-field--error > #unity-text-input {
    border-left-color: var(--dld-color-border-error);
    border-right-color: var(--dld-color-border-error);
    border-top-color: var(--dld-color-border-error);
    border-bottom-color: var(--dld-color-border-error);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.dld-checkbox--error > .unity-toggle__input > #unity-checkmark {
    border-left-color: var(--dld-color-border-error);
    border-right-color: var(--dld-color-border-error);
    border-top-color: var(--dld-color-border-error);
    border-bottom-color: var(--dld-color-border-error);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.dld-grid-toggle > #unity-toggle-button-group__container {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.dld-grid-toggle--error {
    margin-bottom: 0;
}

.dld-grid-toggle--error .unity-button-group__button--left {
    border-left-color: var(--dld-color-border-error);
    border-top-color: var(--dld-color-border-error);
    border-bottom-color: var(--dld-color-border-error);
}

.dld-grid-toggle--error .unity-button-group__button--mid {
    border-top-color: var(--dld-color-border-error);
    border-bottom-color: var(--dld-color-border-error);
}

.dld-grid-toggle--error .unity-button-group__button--right {
    border-top-color: var(--dld-color-border-error);
    border-bottom-color: var(--dld-color-border-error);
    border-right-color: var(--dld-color-border-error);
}

.dld-grid-toggle__row1--error .unity-button-group__button--left {
    border-left-color: var(--dld-color-border-error);
    border-top-color: var(--dld-color-border-error);
}

.dld-grid-toggle__row1--error .unity-button-group__button--mid {
    border-top-color: var(--dld-color-border-error);
}

.dld-grid-toggle__row1--error .unity-button-group__button--right {
    border-top-color: var(--dld-color-border-error);
    border-right-color: var(--dld-color-border-error);
}

.dld-grid-toggle__row2--error .unity-button-group__button--left {
    border-left-color: var(--dld-color-border-error);
}

.dld-grid-toggle__row2--error .unity-button-group__button--right {
    border-right-color: var(--dld-color-border-error);
}

.dld-grid-toggle__row3--error .unity-button-group__button--left {
    border-left-color: var(--dld-color-border-error);
    border-bottom-color: var(--dld-color-border-error);
}

.dld-grid-toggle__row3--error .unity-button-group__button--mid {
    border-bottom-color: var(--dld-color-border-error);
}

.dld-grid-toggle__row3--error .unity-button-group__button--right {
    border-bottom-color: var(--dld-color-border-error);
    border-right-color: var(--dld-color-border-error);
}

.dld-box--error {
    border-left-color: var(--dld-color-border-error);
    border-right-color: var(--dld-color-border-error);
    border-top-color: var(--dld-color-border-error);
    border-bottom-color: var(--dld-color-border-error);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.dld-box--warning {
    border-left-color: var(--dld-color-border-warning);
    border-right-color: var(--dld-color-border-warning);
    border-top-color: var(--dld-color-border-warning);
    border-bottom-color: var(--dld-color-border-warning);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.dld-label--warning {
    color: var(--dld-color-border-warning);
}

.dld-label--error {
    color: var(--dld-color-border-error);
}

.dld-label--filename {
    color: rgb(207, 207, 207);
}

.dld-label--filename-extension {
    color: rgb(119, 119, 119);
}

FilenameTextField > #unity-text-input > TextElement {
    flex-grow: 0;
    flex-shrink: 1;
    padding-right: 0;
}

FilenameTextField > #unity-text-input > Label {
    padding-left: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.dld-icon {
    width: 16px;
    height: 16px;
    align-self: center;
}

.dld-modal-dialog-outside {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dld-popup-menu__bg {
    min-height: 16px;
    background-color: rgb(84, 84, 84);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(41, 41, 41);
    border-right-color: rgb(41, 41, 41);
    border-top-color: rgb(41, 41, 41);
    border-bottom-color: rgb(41, 41, 41);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    height: initial;
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    margin-left: -1px;
}

.dld-popup-menu__bg > TreeView {
    flex-grow: 1;
    max-height: none;
}

.dld-popup-menu__bg > ListView {
    max-height: 100%;
    flex-grow: 1;
}

.dld-popup-menu__bg > ListView .unity-list-view__empty-label {
    display: none;
}

.dld-list-view-entry-group {
    flex-direction: row;
    padding-left: 2px;
    padding-right: 4px;
}

.unity-multi-column-header__column--sortable {
    flex-direction: row;
}

.dld-grid-toggle--with-icon {
    flex-direction: row;
}

.dld-scroll-view--expand-width {
    flex-grow: 1;
}

.dld-button-burger {
    width: 19px;
    height: 19px;
    padding-top: 3px;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-left: 2px;
    border-left-color: rgb(56, 56, 56);
    border-right-color: rgb(56, 56, 56);
    border-top-color: rgb(56, 56, 56);
    border-bottom-color: rgb(38, 38, 38);
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Packages/com.dreamlordsdigital.editor.assets/GUI/Dark/DropdownBg.png?fileID=2800000&guid=a872d0542b3b37945a6b9c1a24050b4c&type=3#DropdownBg");
    -unity-slice-left: 1;
    -unity-slice-top: 1;
    -unity-slice-right: 1;
    -unity-slice-bottom: 1;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.dld-button-burger > .unity-toggle__input {
    display: none;
}

.dld-button-burger:checked {
    background-image: url("project://database/Packages/com.dreamlordsdigital.editor.assets/GUI/Dark/DropdownBg-Pressed.png?fileID=2800000&guid=18fd4f0c6ac81754d9052c1d3f3f2088&type=3#DropdownBg-Pressed");
    padding-top: 5px;
}
