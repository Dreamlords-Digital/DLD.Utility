.dld-color-picker--big-color-container {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 1;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    margin-right: 8px;
}

.dld-color-picker--big-color {
    background-color: rgb(255, 255, 255);
    margin-top: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    margin-left: 8px;
    aspect-ratio: 1;
    flex-shrink: 1;
    height: 100%;
    min-width: 256px;
    min-height: 256px;
    overflow: hidden;
}

.dld-color-picker--big-color--dragging {
    cursor: url("project://database/Packages/com.dreamlordsdigital.editor.assets/MouseCursor/Custom/Hidden.png?fileID=2800000&guid=805122710cf2619a59a91f3ae277ae03&type=3#Hidden");
}

.dld-color-picker--color-cursor {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Packages/com.dreamlordsdigital.editor.assets/MouseCursor/Custom/ColorPickerCursor.png?fileID=2800000&guid=1c408b8428fe4cede9e39f8d877d6a87&type=3#ColorPickerCursor");
    position: absolute;
    background-size: 16px 16px;
}

.dld-color-picker--hue-slider {
    background-color: rgb(255, 255, 255);
    flex-grow: 1;
    flex-shrink: 0;
    width: 27px;
    position: relative;
    margin-top: 8px;
    margin-bottom: 8px;
    margin-right: 28px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.dld-color-picker--hue-slider .unity-base-slider__tracker {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    visibility: hidden;
}

.dld-color-picker--hue-slider .unity-base-slider__dragger-border {
    background-image: none;
    left: 25px;
    width: 20px;
    height: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.dld-color-picker--hue-slider .unity-base-slider__dragger {
    background-image: none;
    left: 25px;
    width: 20px;
    height: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.dld-slider__dragger-border-image {
    width: 30px;
    height: 30px;
    position: absolute;
    top: -15px;
    background-image: url("project://database/Packages/com.dreamlordsdigital.editor.assets/Icons/Custom/SliderArrowBorder.svg?fileID=7388822144124034973&guid=8a61e2e5695cd24c3aabf458e6c0d7e6&type=3#SliderArrowBorder");
    background-size: 18px 25px;
    -unity-background-image-tint-color: var(--unity-colors-slider_thumb_halo-background);
    background-position-x: left 2px;
    visibility: hidden;
}

.dld-color-picker--hue-slider:focus .dld-slider__dragger-border-image {
    visibility: visible;
}

.dld-slider__dragger-image {
    width: 20px;
    height: 20px;
    position: absolute;
    top: -10px;
    background-image: url("project://database/Packages/com.dreamlordsdigital.editor.assets/Icons/Custom/SliderArrow.svg?fileID=7388822144124034973&guid=8b461346d3fe586c8944880052d3b037&type=3#SliderArrow");
    background-size: 15px 15px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.dld-color-picker--controls-container {
    flex-shrink: 1;
    flex-grow: 0;
    min-height: 90px;
    flex-direction: row;
    margin-left: 5px;
    margin-right: 5px;
}

.dld-color-picker--color-swatch-container {
    min-width: 80px;
    flex-shrink: 1;
    flex-grow: 0;
    width: 80px;
    max-width: 80px;
    margin-bottom: 3px;
}

.dld-color-picker--color-swatch {
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 0;
    margin-left: 3px;
    background-color: rgb(63, 63, 63);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(33, 33, 33);
    border-right-color: rgb(33, 33, 33);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(33, 33, 33);
    min-width: 60px;
    flex-grow: 0;
    height: 47px;
}

.dld-color-picker--slider-container {
    flex-grow: 1;
    flex-shrink: 0;
    padding-top: 5px;
}

.dld-color-picker--slider {
    flex-grow: 0;
    margin-bottom: 5px;
}

.dld-color-picker--slider Label {
    flex-shrink: 1;
    min-width: 15px;
}

.dld-color-picker--confirmation-container {
    height: 50px;
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 0;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 16px;
}

.dld-color-picker--confirmation-button {
    width: 70px;
}
