.dld-context__outside {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    --dropdown--button-fit-width-adjust: 4;
}

.dld-context-menu {
    left: 5px;
    top: -3px;
    position: absolute;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Packages/com.dreamlordsdigital.editor.assets/GUI/Dark/ContextMenuBg.psd?fileID=2800000&guid=98b932785ab5a9542a414d156df0d36b&type=3#ContextMenuBg");
    -unity-slice-left: 8;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    padding-top: 5px;
    padding-right: 3px;
    padding-bottom: 5px;
    padding-left: 3px;
}

.dld-context-menu--as-dropdown {
    position: absolute;
    background-image: url("project://database/Packages/com.dreamlordsdigital.editor.assets/GUI/Dark/DropdownMenuBg.psd?fileID=2800000&guid=f9c82b9396e53f84385e1793d07838ae&type=3#DropdownMenuBg");
    top: -1px;
    left: -2px;
    -unity-slice-top: 1;
}

.dld-context-menu--as-dropdown--longer {
    background-image: url("project://database/Packages/com.dreamlordsdigital.editor.assets/GUI/Dark/DropdownMenuLongerBg.psd?fileID=2800000&guid=7cfb8d0b41e0185439b9a2ae980af293&type=3#DropdownMenuLongerBg");
    -unity-slice-top: 8;
}

.dld-context-menu--as-dropdown > .dld-context-menu-entry-container {
    height: 20px;
}

.dld-context-menu-entry-container {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
    flex-direction: row;
    padding-top: 0;
    padding-right: 8px;
    padding-left: 5px;
    color: rgb(190, 190, 190);
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-left: 0;
    padding-bottom: 0;
    height: 23px;
}

.dld-context-menu-entry-container--alt-bg {
    background-color: rgba(0, 0, 0, 0.23);
}

.dld-context-menu-entry-container > #Icon {
}

.dld-context-menu-entry__label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-text-align: middle-left;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 2px;
    color: rgb(190, 190, 190);
    font-size: 12px;
    -unity-font-style: bold;
}

.dld-context-menu-entry-container:hover {
    background-color: rgba(70, 149, 215, 0.5);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    margin-right: 2px;
    margin-left: 1px;
    padding-left: 4px;
    padding-right: 6px;
}

.dld-context-menu-entry-container:hover > .dld-context-menu-entry__label {
    color: rgb(255, 255, 255);
}

.dld-context-menu-entry-container:focus {
    background-color: rgba(70, 149, 215, 0.5);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(28, 60, 87);
    border-right-color: rgb(28, 60, 87);
    border-top-color: rgb(28, 60, 87);
    border-bottom-color: rgb(28, 60, 87);
    padding-left: 4px;
}

.dld-context-menu-entry-container:focus > .dld-context-menu-entry__label {
    color: rgb(255, 255, 255);
}

.dld-context-menu-entry-container--active:focus {
    background-color: rgba(28, 60, 87, 0.8);
    color: rgb(245, 245, 245);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    margin-right: 1px;
    margin-left: 1px;
    padding-left: 3px;
    padding-top: 2px;
}

.dld-context-menu-entry-separator {
    border-left-color: rgb(178, 178, 178);
    border-right-color: rgb(60, 60, 60);
    border-top-color: rgb(177, 177, 177);
    border-bottom-color: rgb(60, 60, 60);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    height: 2px;
    align-self: center;
    flex-grow: 1;
}

.dld-context-menu-entry-container--separator {
    height: 10px;
    flex-direction: row;
    padding-left: 5px;
    padding-right: 5px;
}

.dld-context-menu-entry-container--disabled {
    opacity: 0.5;
    color: rgb(130, 130, 130);
}

.dld-context-menu-entry-container--disabled:hover {
    background-color: rgb(110, 119, 126);
    padding-left: 4px;
    padding-right: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-right: 2px;
    margin-left: 1px;
}

.dld-context-menu-entry-container--disabled:focus {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-left: 1px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding-right: 6px;
    background-color: rgb(89, 96, 103);
}

.dld-context-menu-entry__label--selected {
    color: rgb(255, 255, 255);
}
